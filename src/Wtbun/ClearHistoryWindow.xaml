<Window x:Class="Wtbun.ClearHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Wtbun.Localization"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,2,0,0" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="{l:Tr ClearHistory_Prompt}" Margin="0,0,0,8" />

        <RadioButton x:Name="UnusableOption" GroupName="Scope" IsChecked="True" />
        <TextBlock Text="{l:Tr ClearHistory_UnusableHint}" Style="{StaticResource HintStyle}" />

        <RadioButton x:Name="AllOption" GroupName="Scope" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearButton" Content="{l:Tr ClearHistory_Clear}" Style="{StaticResource DialogButtonStyle}" Click="Clear_Click" />
            <!-- 誤って消さないよう、Enter はキャンセルにする -->
            <Button Content="{l:Tr Common_Cancel}" IsDefault="True" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
