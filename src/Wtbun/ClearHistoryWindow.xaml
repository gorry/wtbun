<Window x:Class="Wtbun.ClearHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="20,2,0,0" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="消去するフォルダーを選択してください。" Margin="0,0,0,8" />

        <RadioButton x:Name="UnusableOption" GroupName="Scope" IsChecked="True" />
        <TextBlock Text="フォルダーがなくなったか、構成ファイルがなくなったフォルダーです。" Style="{StaticResource HintStyle}" />

        <RadioButton x:Name="AllOption" GroupName="Scope" Margin="0,8,0,0" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="ClearButton" Content="消去" Style="{StaticResource DialogButtonStyle}" Click="Clear_Click" />
            <!-- 誤って消さないよう、Enter はキャンセルにする -->
            <Button Content="キャンセル" IsDefault="True" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
