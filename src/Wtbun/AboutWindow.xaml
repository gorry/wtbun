<Window x:Class="Wtbun.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Wtbun.Localization"
        Width="700"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <!-- NOTICE と LICENSE の本文。等幅で、行を折り返さない（字下げや区切り線を崩さないように） -->
        <Style x:Key="LicenseTextStyle" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas, BIZ UDGothic, MS Gothic" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="16">
        <DockPanel>
            <Image x:Name="AppIcon"
                   DockPanel.Dock="Left"
                   Width="64" Height="64"
                   Margin="0,0,16,0"
                   VerticalAlignment="Top"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="VersionText" Margin="0,4,0,0" />
                <TextBlock x:Name="CopyrightText" Margin="0,4,0,0" TextWrapping="Wrap" />
                <TextBlock x:Name="ProjectLinkLine" Margin="0,4,0,0" TextWrapping="Wrap">
                    <Hyperlink x:Name="ProjectLink" Click="Link_Click">
                        <Run x:Name="ProjectLinkText" />
                    </Hyperlink>
                </TextBlock>
            </StackPanel>
        </DockPanel>

        <!-- タブを切り替えてもウィンドウの高さが変わらないよう、高さを決めておく -->
        <TabControl Margin="0,16,0,0" Height="320">
            <TabItem Header="NOTICE">
                <DockPanel>
                    <TextBlock x:Name="NoticeLinkLine" DockPanel.Dock="Bottom" Margin="4,4,4,2">
                        <Hyperlink x:Name="NoticeLink" Click="Link_Click"><Run Text="{l:Tr About_ShowLatest}" /></Hyperlink>
                    </TextBlock>
                    <TextBox x:Name="NoticeBox" AutomationProperties.Name="NOTICE" Style="{StaticResource LicenseTextStyle}" />
                </DockPanel>
            </TabItem>
            <TabItem Header="LICENSE">
                <TextBox x:Name="LicenseBox" AutomationProperties.Name="LICENSE" Style="{StaticResource LicenseTextStyle}" />
            </TabItem>
        </TabControl>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Tr About_CopyVersion}" Style="{StaticResource DialogButtonStyle}" Click="Copy_Click" />
            <Button Content="{l:Tr Common_Close}" IsDefault="True" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
