<Window x:Class="Wtbun.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Wtbun.Localization"
        Width="360"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="{l:Tr Settings_Language}" Margin="0,0,0,2" />
        <!-- 言語の名前は、その言語自身で書く（今の言語が読めない人でも選べるように） -->
        <ComboBox x:Name="LanguageBox"
                  AutomationProperties.Name="{l:Tr Settings_Language}"
                  DisplayMemberPath="DisplayName"
                  SelectedValuePath="Name" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{l:Tr Common_OK}" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="Ok_Click" />
            <Button Content="{l:Tr Common_Cancel}" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
