<Window x:Class="Wtbun.ProjectConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="ListButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <!-- ペインを選ぶと項目が増えて高くなるので、画面に収まらないときはスクロールする -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="プロジェクト名" Margin="0,0,0,2" />
                    <TextBox x:Name="NameBox" AutomationProperties.Name="プロジェクト名" />
                    <TextBlock Text="空欄の場合はフォルダー名を表示します。" Style="{StaticResource HintStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="アイコン" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="White" Padding="2">
                            <Image x:Name="IconPreview"
                                   AutomationProperties.Name="アイコン"
                                   Width="48" Height="48"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Button Content="インポート…" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Bottom" Click="ImportIcon_Click" />
                    </StackPanel>
                    <TextBlock x:Name="IconHint" Style="{StaticResource HintStyle}" MaxWidth="240" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <TextBlock Text="開くタブとペイン" Margin="0,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="DuplicateButton" Content="複製" Style="{StaticResource ListButtonStyle}" Click="Duplicate_Click" />
                        <Button x:Name="RemoveTabButton" Content="削除" Style="{StaticResource ListButtonStyle}" Click="RemoveTab_Click" />
                        <Button x:Name="MoveUpButton" Content="上へ" Style="{StaticResource ListButtonStyle}" Click="MoveUp_Click" />
                        <Button x:Name="MoveDownButton" Content="下へ" Style="{StaticResource ListButtonStyle}" Margin="0" Click="MoveDown_Click" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="タブを追加" Style="{StaticResource ListButtonStyle}" Click="AddTab_Click" />
                        <Button x:Name="AddPaneButton" Content="ペインを追加" Style="{StaticResource ListButtonStyle}" Margin="0" Click="AddPane_Click" />
                    </StackPanel>
                    <ListBox x:Name="TabList"
                             AutomationProperties.Name="開くタブ"
                             DisplayMemberPath="Header"
                             SelectionChanged="TabList_SelectionChanged" />
                </DockPanel>

                <!-- 左の一覧で選ばれているタブかペインの内容 -->
                <StackPanel Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=TabList}">
                    <CheckBox Content="{Binding SelectedLabel}"
                          IsChecked="{Binding IsSelectedOnOpen}" />
                <TextBlock Text="{Binding SelectedHint}" Style="{StaticResource HintStyle}" Margin="0,2,0,8" />

                <!-- ペインだけの項目 -->
                    <StackPanel Visibility="{Binding IsPane, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                        <TextBlock Text="分割の向き" Margin="0,0,0,2" />
                        <ComboBox AutomationProperties.Name="分割の向き"
                                  SelectedIndex="{Binding SplitIndex}">
                            <ComboBoxItem Content="自動" />
                            <ComboBoxItem Content="右に分割" />
                            <ComboBoxItem Content="下に分割" />
                        </ComboBox>
                        <TextBlock Text="直前のペインを分割します。自動の場合は、ペインの縦横の長さで決まります。" Style="{StaticResource HintStyle}" />

                        <TextBlock Text="サイズ（%）" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox AutomationProperties.Name="サイズ"
                                 Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="分割する前のペインに対する大きさです。空欄の場合は半分です。" Style="{StaticResource HintStyle}" />

                        <CheckBox Content="直前のペインを複製"
                                  Margin="0,8,0,0"
                                  IsChecked="{Binding Duplicate}" />
                        <TextBlock Text="直前のペインと同じプロファイルとフォルダーで開きます。" Style="{StaticResource HintStyle}" />
                    </StackPanel>

                    <TextBlock Text="タイトル" Margin="0,0,0,2" />
                    <TextBox AutomationProperties.Name="タイトル"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="空欄の場合は Windows Terminal が設定します。" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="開始フォルダー" Style="{StaticResource FieldLabelStyle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="参照…" Margin="4,0,0,0" Padding="8,0" Click="BrowseDir_Click" />
                        <TextBox AutomationProperties.Name="開始フォルダー"
                                 Text="{Binding Dir, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="空欄の場合はプロジェクトのフォルダーです。相対パスも使用できます。" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="プロファイル" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ProfileBox"
                              AutomationProperties.Name="プロファイル"
                              IsEditable="True"
                              Text="{Binding Profile, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="空欄の場合は既定のプロファイルを使用します。" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="コマンド" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox AutomationProperties.Name="コマンド"
                             Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="コマンドが終了するとタブも閉じます。空欄の場合はプロファイルの設定に従います。" Style="{StaticResource HintStyle}" />

                    <CheckBox Content="コマンドをプロファイルのコマンドの後ろに追加"
                              Margin="0,8,0,0"
                              IsChecked="{Binding AppendCommandLine}" />
                    <TextBlock Text="コマンドには、プロファイルのコマンドに渡す引数を入力します。" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="タブの色" Style="{StaticResource FieldLabelStyle}" />
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="22" Margin="4,0,0,0"
                                BorderBrush="#C8C8C8" BorderThickness="1"
                                Background="{Binding TabColorBrush}" />
                        <TextBox AutomationProperties.Name="タブの色"
                                 Text="{Binding TabColor, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="#RRGGBB の形式で入力します（例：#2E7D32）。空欄の場合はプロファイルの設定に従います。" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="配色" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ColorSchemeBox"
                              AutomationProperties.Name="配色"
                              IsEditable="True"
                              Text="{Binding ColorScheme, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="空欄の場合はプロファイルの設定に従います。" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="プログラムによるタイトルの変更" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox AutomationProperties.Name="プログラムによるタイトルの変更"
                              SelectedIndex="{Binding SuppressApplicationTitleIndex}">
                        <ComboBoxItem Content="プロファイルの設定に従う" />
                        <ComboBoxItem Content="許可する" />
                        <ComboBoxItem Content="許可しない" />
                    </ComboBox>

                    <TextBlock Text="環境変数" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox AutomationProperties.Name="環境変数"
                              SelectedIndex="{Binding InheritEnvironmentIndex}">
                        <ComboBoxItem Content="既定" />
                        <ComboBoxItem Content="Windows Terminal から引き継ぐ" />
                        <ComboBoxItem Content="新しく読み込む" />
                    </ComboBox>
                    <TextBlock Text="既定では、コマンドを指定した場合に引き継ぎます。" Style="{StaticResource HintStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="タブとペインの変更は次回プロジェクトを開いたときに反映されます。" Margin="0,12,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="保存" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="Save_Click" />
                <Button Content="キャンセル" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
