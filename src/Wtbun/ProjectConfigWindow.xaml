<Window x:Class="Wtbun.ProjectConfigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:Wtbun.Localization"
        Width="640"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,2" />
        </Style>
        <Style x:Key="ListButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,2" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <!-- ペインを選ぶと項目が増えて高くなるので、画面に収まらないときはスクロールする -->
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{l:Tr Config_ProjectName}" Margin="0,0,0,2" />
                    <TextBox x:Name="NameBox" AutomationProperties.Name="{l:Tr Config_ProjectName}" />
                    <TextBlock Text="{l:Tr Config_ProjectNameHint}" Style="{StaticResource HintStyle}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{l:Tr Config_Icon}" Margin="0,0,0,2" />
                    <StackPanel Orientation="Horizontal">
                        <Border BorderBrush="#C8C8C8" BorderThickness="1" Background="White" Padding="2">
                            <Image x:Name="IconPreview"
                                   AutomationProperties.Name="{l:Tr Config_Icon}"
                                   Width="48" Height="48"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <Button Content="{l:Tr Config_Import}" Margin="8,0,0,0" Padding="8,2" VerticalAlignment="Bottom" Click="ImportIcon_Click" />
                    </StackPanel>
                    <TextBlock x:Name="IconHint" Style="{StaticResource HintStyle}" MaxWidth="240" HorizontalAlignment="Left" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{l:Tr Config_TabsAndPanes}" Margin="0,12,0,2" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button x:Name="DuplicateButton" Content="{l:Tr Config_Duplicate}" Style="{StaticResource ListButtonStyle}" Click="Duplicate_Click" />
                        <Button x:Name="RemoveTabButton" Content="{l:Tr Config_Remove}" Style="{StaticResource ListButtonStyle}" Click="RemoveTab_Click" />
                        <Button x:Name="MoveUpButton" Content="{l:Tr Config_MoveUp}" Style="{StaticResource ListButtonStyle}" Click="MoveUp_Click" />
                        <Button x:Name="MoveDownButton" Content="{l:Tr Config_MoveDown}" Style="{StaticResource ListButtonStyle}" Margin="0" Click="MoveDown_Click" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="{l:Tr Config_AddTab}" Style="{StaticResource ListButtonStyle}" Click="AddTab_Click" />
                        <Button x:Name="AddPaneButton" Content="{l:Tr Config_AddPane}" Style="{StaticResource ListButtonStyle}" Margin="0" Click="AddPane_Click" />
                    </StackPanel>
                    <ListBox x:Name="TabList"
                             AutomationProperties.Name="{l:Tr Config_TabList}"
                             DisplayMemberPath="Header"
                             SelectionChanged="TabList_SelectionChanged" />
                </DockPanel>

                <!-- 左の一覧で選ばれているタブかペインの内容 -->
                <StackPanel Grid.Column="2" DataContext="{Binding SelectedItem, ElementName=TabList}">
                    <CheckBox Content="{Binding SelectedLabel}"
                          IsChecked="{Binding IsSelectedOnOpen}" />
                <TextBlock Text="{Binding SelectedHint}" Style="{StaticResource HintStyle}" Margin="0,2,0,8" />

                <!-- ペインだけの項目 -->
                    <StackPanel Visibility="{Binding IsPane, Converter={StaticResource VisibleWhenTrue}}" Margin="0,0,0,8">
                        <TextBlock Text="{l:Tr Config_SplitDirection}" Margin="0,0,0,2" />
                        <ComboBox AutomationProperties.Name="{l:Tr Config_SplitDirection}"
                                  SelectedIndex="{Binding SplitIndex}">
                            <ComboBoxItem Content="{l:Tr Config_SplitAuto}" />
                            <ComboBoxItem Content="{l:Tr Config_SplitRight}" />
                            <ComboBoxItem Content="{l:Tr Config_SplitDown}" />
                        </ComboBox>
                        <TextBlock Text="{l:Tr Config_SplitHint}" Style="{StaticResource HintStyle}" />

                        <TextBlock Text="{l:Tr Config_Size}" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox AutomationProperties.Name="{l:Tr Config_SizeName}"
                                 Text="{Binding SizeText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{l:Tr Config_SizeHint}" Style="{StaticResource HintStyle}" />

                        <CheckBox Content="{l:Tr Config_DuplicatePane}"
                                  Margin="0,8,0,0"
                                  IsChecked="{Binding Duplicate}" />
                        <TextBlock Text="{l:Tr Config_DuplicatePaneHint}" Style="{StaticResource HintStyle}" />
                    </StackPanel>

                    <TextBlock Text="{l:Tr Config_TabTitle}" Margin="0,0,0,2" />
                    <TextBox AutomationProperties.Name="{l:Tr Config_TabTitle}"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:Tr Config_TabTitleHint}" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="{l:Tr Config_StartFolder}" Style="{StaticResource FieldLabelStyle}" />
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{l:Tr Config_Browse}" Margin="4,0,0,0" Padding="8,0" Click="BrowseDir_Click" />
                        <TextBox AutomationProperties.Name="{l:Tr Config_StartFolder}"
                                 Text="{Binding Dir, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{l:Tr Config_StartFolderHint}" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="{l:Tr Config_Profile}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ProfileBox"
                              AutomationProperties.Name="{l:Tr Config_Profile}"
                              IsEditable="True"
                              Text="{Binding Profile, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:Tr Config_ProfileHint}" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="{l:Tr Config_Command}" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox AutomationProperties.Name="{l:Tr Config_Command}"
                             Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:Tr Config_CommandHint}" Style="{StaticResource HintStyle}" />

                    <CheckBox Content="{l:Tr Config_Append}"
                              Margin="0,8,0,0"
                              IsChecked="{Binding AppendCommandLine}" />
                    <TextBlock Text="{l:Tr Config_AppendHint}" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="{l:Tr Config_TabColor}" Style="{StaticResource FieldLabelStyle}" />
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Width="22" Margin="4,0,0,0"
                                BorderBrush="#C8C8C8" BorderThickness="1"
                                Background="{Binding TabColorBrush}" />
                        <TextBox AutomationProperties.Name="{l:Tr Config_TabColor}"
                                 Text="{Binding TabColor, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                    <TextBlock Text="{l:Tr Config_TabColorHint}" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="{l:Tr Config_ColorScheme}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox x:Name="ColorSchemeBox"
                              AutomationProperties.Name="{l:Tr Config_ColorScheme}"
                              IsEditable="True"
                              Text="{Binding ColorScheme, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="{l:Tr Config_FollowProfileHint}" Style="{StaticResource HintStyle}" />

                    <TextBlock Text="{l:Tr Config_TitleChange}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox AutomationProperties.Name="{l:Tr Config_TitleChange}"
                              SelectedIndex="{Binding SuppressApplicationTitleIndex}">
                        <ComboBoxItem Content="{l:Tr Config_FollowProfile}" />
                        <ComboBoxItem Content="{l:Tr Config_Allow}" />
                        <ComboBoxItem Content="{l:Tr Config_Deny}" />
                    </ComboBox>

                    <TextBlock Text="{l:Tr Config_Environment}" Style="{StaticResource FieldLabelStyle}" />
                    <ComboBox AutomationProperties.Name="{l:Tr Config_Environment}"
                              SelectedIndex="{Binding InheritEnvironmentIndex}">
                        <ComboBoxItem Content="{l:Tr Config_EnvDefault}" />
                        <ComboBoxItem Content="{l:Tr Config_EnvInherit}" />
                        <ComboBoxItem Content="{l:Tr Config_EnvReload}" />
                    </ComboBox>
                    <TextBlock Text="{l:Tr Config_EnvHint}" Style="{StaticResource HintStyle}" />
                </StackPanel>
            </Grid>

            <TextBlock Text="{l:Tr Config_ApplyNote}" Margin="0,12,0,0" TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{l:Tr Config_Save}" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="Save_Click" />
                <Button Content="{l:Tr Common_Cancel}" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
