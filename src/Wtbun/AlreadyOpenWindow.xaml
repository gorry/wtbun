<Window x:Class="Wtbun.AlreadyOpenWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual">
    <Window.Resources>
        <Style x:Key="HintStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="12">
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
        <TextBlock Text="開き直すと、構成ファイルを読み込み直してウィンドウを開き直します。実行中のコマンドは終了します。" Style="{StaticResource HintStyle}" />
        <TextBlock x:Name="TerminalHint" Style="{StaticResource HintStyle}" Visibility="Collapsed" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="開き直す" Style="{StaticResource DialogButtonStyle}" Click="Reopen_Click" />
            <!-- 実行中のコマンドを誤って終了させないよう、Enter は前面に表示にする -->
            <Button Content="前面に表示" IsDefault="True" Style="{StaticResource DialogButtonStyle}" Click="Activate_Click" />
            <Button Content="キャンセル" IsCancel="True" Style="{StaticResource DialogButtonStyle}" />
        </StackPanel>
    </StackPanel>
</Window>
